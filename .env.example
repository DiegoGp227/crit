# ─── Backend ───
# Dentro de Docker, la DB es interna y se accede por el nombre del servicio `postgres`.
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/crit_db"
PORT=8000
JWT_SECRET=crit-jwt-secret
CORS_ORIGIN=http://localhost:3000
TOKEN_EXPIRATION=1h

# ─── MinIO ───
# Dentro de Docker, MinIO es interno y se accede por el nombre del servicio `minio`.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=crit-images
# URL pública para servir imágenes (la usa el front para construir las URLs).
MINIO_PUBLIC_URL=http://localhost:9000

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ─── Docker Compose ports ───
FRONT_PORT=3000
BACK_PORT=8000
